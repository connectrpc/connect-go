# grpchealth.NewClient takes a *connect.Client in v2, like grpcreflect.
exec migrate
cmp stdout out.txt
stdout 'grpchealth_client=1'
-- ecosystem_grpchealth_client.go --
package example

import (
	"net/http"

	"connectrpc.com/grpchealth"
)

func newHealthClient() *grpchealth.Client {
	return grpchealth.NewClient(http.DefaultClient, "http://localhost:8080")
}
-- out.txt --
Proposed rewrites (rerun with -w to apply):
  ./ecosystem_grpchealth_client.go: grpchealth_client=1 import_add_connecthttp=1 import_add_connectv2=1 import_ecosystem_v2=1 read_limit_pinned=1
--- ./ecosystem_grpchealth_client.go
+++ ./ecosystem_grpchealth_client.go
@@ -3,10 +3,12 @@
 import (
 	"net/http"
 
-	"connectrpc.com/grpchealth"
+	"connectrpc.com/connect/v2"
+	"connectrpc.com/connect/v2/connecthttp"
+	"connectrpc.com/grpchealth/v2"
 )
 
 func newHealthClient() *grpchealth.Client {
-	return grpchealth.NewClient(http.DefaultClient, "http://localhost:8080")
+	return grpchealth.NewClient(connect.NewClient(connecthttp.NewTransport(http.DefaultClient, "http://localhost:8080", connecthttp.WithReadMaxBytes(0))))
 }
 


The following issues require manual code changes:
  ./ecosystem_grpchealth_client.go:10:9: v2 limits reads to 4 MiB per message where v1 allowed any size, so this call is pinned to WithReadMaxBytes(0) to keep v1 behaviour. Drop it to take the v2 default.

Scanned 1 Go file and 0 Buf templates. 1 rewrite(s) ready (rerun with -w to apply).

go.mod needs the connect v2 modules. Pull them in and tidy:

  go get -u \
       connectrpc.com/grpchealth/v2@main
  go mod tidy
Full migration guide: https://github.com/connectrpc/connect-go/blob/main/docs/v2-migration.md
