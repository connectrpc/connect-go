# Client construction with interceptors: connecthttp.NewClient keeps the v1
# argument shape, so interceptors stay in the same option list behind
# connecthttp.WithInterceptors rather than moving to a separate call. The
# validate interceptor module has no v2 build yet (golden-only).
stubs v2
exec migrate
cmp stdout out.txt
-- client_interceptor.go --
package app

import (
	"net/http"

	"connectrpc.com/connect"
	"connectrpc.com/validate"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

func newClient() pingv1connect.PingServiceClient {
	return pingv1connect.NewPingServiceClient(
		http.DefaultClient,
		"http://localhost:8080/",
		connect.WithInterceptors(validate.NewInterceptor()),
	)
}
