-	return pingv1connect.NewPingServiceClient(
-		http.DefaultClient,
-		"http://localhost:8080/",
-		connect.WithInterceptors(validate.NewInterceptor()),
+	return pingv1connect.NewPingServiceClient(connecthttp.NewClient(http.DefaultClient,
