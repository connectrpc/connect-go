# The go get advice names only ecosystem modules that still need an upgrade.
# grpchealth/v2 is already required, and validate keeps its path but already
# resolves to a connect v2 build, so both are left out. otelconnect keeps its
# path and still imports connect v1, so it is suggested at @latest.
exec migrate
cmp stdout out.txt
stdout 'connectrpc.com/otelconnect@latest'
! stdout 'connectrpc.com/validate@latest'
! stdout 'connectrpc.com/grpchealth/v2@latest'
exec go build ./...
-- go.mod --
module example.com/app

go 1.25

require (
	connectrpc.com/connect v1.18.1
	connectrpc.com/connect/v2 v2.0.0
	connectrpc.com/grpchealth/v2 v2.0.0
	connectrpc.com/otelconnect v0.10.0
	connectrpc.com/validate v0.7.0
)

replace (
	connectrpc.com/connect => ./connectv1
	connectrpc.com/connect/v2 => ./connectv2
	connectrpc.com/grpchealth/v2 => ./grpchealth
	connectrpc.com/otelconnect => ./otelconnect
	connectrpc.com/validate => ./validate
)
-- app.go --
package app

import (
	"connectrpc.com/grpchealth/v2"
	"connectrpc.com/otelconnect"
	"connectrpc.com/validate"
)

var _ = grpchealth.Name + otelconnect.Name + validate.Name
-- connectv1/go.mod --
module connectrpc.com/connect

go 1.25
-- connectv1/connect.go --
// Package connect is a minimal stand-in for connectrpc.com/connect v1.
package connect

// Code is a stand-in error code.
type Code uint32
-- connectv2/go.mod --
module connectrpc.com/connect/v2

go 1.25
-- connectv2/connect.go --
// Package connect is a minimal stand-in for connectrpc.com/connect/v2.
package connect

// Code is a stand-in error code.
type Code uint32
-- grpchealth/go.mod --
module connectrpc.com/grpchealth/v2

go 1.25

require connectrpc.com/connect/v2 v2.0.0
-- grpchealth/health.go --
// Package grpchealth stands in for grpchealth v2.
package grpchealth

import "connectrpc.com/connect/v2"

var _ connect.Code

// Name is a stand-in export.
const Name = "grpchealth"
-- otelconnect/go.mod --
module connectrpc.com/otelconnect

go 1.25

require connectrpc.com/connect v1.18.1
-- otelconnect/otelconnect.go --
// Package otelconnect stands in for an otelconnect build still on connect v1.
package otelconnect

import "connectrpc.com/connect"

var _ connect.Code

// Name is a stand-in export.
const Name = "otelconnect"
-- validate/go.mod --
module connectrpc.com/validate

go 1.25

require connectrpc.com/connect/v2 v2.0.0
-- validate/validate.go --
// Package validate stands in for a validate build on connect v2.
package validate

import "connectrpc.com/connect/v2"

var _ connect.Code

// Name is a stand-in export.
const Name = "validate"
-- out.txt --
Scanned 1 Go file and 0 Buf templates. No automatic rewrites were applied.

go.mod needs the connect v2 modules. Pull them in and tidy:

  go get -u \
       connectrpc.com/otelconnect@latest
  go mod tidy
