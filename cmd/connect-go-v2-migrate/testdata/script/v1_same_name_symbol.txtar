# Once v2 takes over the connect name, v1 symbols whose v2 namesake has a
# different shape are warned too: the generic Client and NewClient, and the
# Codec and Compressor interfaces.
stubs v2
exec migrate
stdout 'connect.NewClient is not generic in connectrpc.com/connect/v2'
stdout 'connect.Client is not generic in connectrpc.com/connect/v2'
stdout 'connect.Codec has a different method set in connectrpc.com/connect/v2'
stdout 'connect.Compressor has a different method set in connectrpc.com/connect/v2'
cmp stdout out.txt
-- service.go --
package app

import (
	"bytes"
	"context"
	"io"
	"net/http"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

type pingServer struct {
	pingv1connect.UnimplementedPingServiceHandler
}

func (s *pingServer) Ping(ctx context.Context, req *connect.Request[pingv1.PingRequest]) (*connect.Response[pingv1.PingResponse], error) {
	if req.Msg.Number < 0 {
		return nil, connect.NewError(connect.CodeInvalidArgument, nil)
	}
	return connect.NewResponse(&pingv1.PingResponse{Number: req.Msg.Number}), nil
}

func newRaw() *connect.Client[pingv1.PingRequest, pingv1.PingResponse] {
	return connect.NewClient[pingv1.PingRequest, pingv1.PingResponse](http.DefaultClient, "http://x/ping.v1.PingService/Ping")
}

type rawCodec struct{}

var _ connect.Codec = rawCodec{}

func (rawCodec) Name() string                         { return "raw" }
func (rawCodec) Marshal(msg any) ([]byte, error)      { return msg.([]byte), nil }
func (rawCodec) Unmarshal(data []byte, msg any) error { return nil }

type nopCompressor struct{ bytes.Buffer }

var _ connect.Compressor = (*nopCompressor)(nil)

func (*nopCompressor) Close() error      { return nil }
func (*nopCompressor) Reset(_ io.Writer) {}
