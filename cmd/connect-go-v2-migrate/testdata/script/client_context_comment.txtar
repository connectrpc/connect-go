# The seeded client context keeps a trailing comment on the line above and a
# leading comment on the call.
stubs v2
exec migrate
cmp stdout out.txt
exec migrate -w
exec go build ./...
exec migrate
! stdout 'Proposed rewrites'
-- client.go --
package app

import (
	"context"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

func notify(ctx context.Context, client pingv1connect.PingServiceClient) (string, error) {
	req := connect.NewRequest(&pingv1.PingRequest{}) // built once
	// Deliver the webhook.
	res, err := client.Ping(ctx, req)
	if err != nil {
		return "", err
	}
	return res.GetText() + res.Header().Get("X-Delivery"), nil
}
-- out.txt --
