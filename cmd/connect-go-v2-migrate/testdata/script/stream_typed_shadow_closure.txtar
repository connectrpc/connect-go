# A closure that declares its own variable with a stream's name gets the
# verdict for that variable, not for the name: a real stream and a look-alike
# can shadow each other in either direction. A plain value that shadows a
# stream in a closure or a block is left alone too.
stubs v2
exec migrate
cmp stdout out.txt
exec migrate -w
exec go build ./...
exec migrate
! stdout 'Proposed rewrites'
-- queue/queue.go --
package queue

// Queue shares the method names of a v1 stream but is not one.
type Queue struct{ items []int64 }

type Opener struct{}

func (Opener) Open() *Queue { return &Queue{} }

func (Opener) Name() string { return "queue" }

func (q *Queue) Send(n int64) error {
	q.items = append(q.items, n)
	return nil
}

func (q *Queue) CloseRequest() error { return nil }
-- service.go --
package app

import (
	"context"
	"fmt"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"

	"example.com/app/queue"
)

// outerStream shadows a real stream with look-alikes in closures.
func outerStream(ctx context.Context, client pingv1connect.PingServiceClient, opener queue.Opener) error {
	if _, err := client.Ping(ctx, connect.NewRequest(&pingv1.PingRequest{})); err != nil {
		return err
	}
	stream := client.CumSum(ctx)
	go func() {
		stream := opener.Open()
		_ = stream.Send(1)
		_ = stream.CloseRequest()
	}()
	go func() {
		stream := opener.Open()
		fmt.Println(stream)
	}()
	if err := stream.Send(&pingv1.CumSumRequest{Number: 1}); err != nil {
		return err
	}
	if err := stream.CloseRequest(); err != nil {
		return err
	}
	return stream.CloseResponse()
}

// outerLookalike shadows a look-alike with a real stream in a closure.
func outerLookalike(ctx context.Context, client pingv1connect.PingServiceClient, opener queue.Opener) error {
	stream := opener.Open()
	if err := stream.Send(1); err != nil {
		return err
	}
	run := func() error {
		stream := client.CumSum(ctx)
		if err := stream.CloseRequest(); err != nil {
			return err
		}
		return stream.CloseResponse()
	}
	return run()
}

// outerPlain shadows a real stream with a plain value in a closure and a
// block.
func outerPlain(ctx context.Context, client pingv1connect.PingServiceClient, opener queue.Opener) error {
	stream := client.CumSum(ctx)
	go func() {
		stream := opener.Name()
		fmt.Println(stream)
	}()
	{
		stream := opener.Name()
		fmt.Println(stream)
	}
	if err := stream.Send(&pingv1.CumSumRequest{Number: 1}); err != nil {
		return err
	}
	return stream.CloseRequest()
}
