# Spec() and Peer() accessors that cannot become server CallInfo fields are
# warned: a blank context, the GET query, a bare Peer(), HTTPMethod(), and
# client requests and streams (golden-only).
stubs v2
exec migrate
cmp stdout out.txt
-- service.go --
package app

import (
	"context"
	"log"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

type pingServer struct {
	pingv1connect.UnimplementedPingServiceHandler
}

func (s *pingServer) Ping(_ context.Context, req *connect.Request[pingv1.PingRequest]) (*connect.Response[pingv1.PingResponse], error) {
	log.Println(req.Spec().Procedure, req.Peer().Addr)
	return connect.NewResponse(&pingv1.PingResponse{}), nil
}

func (s *pingServer) Fail(ctx context.Context, req *connect.Request[pingv1.FailRequest]) (*connect.Response[pingv1.FailResponse], error) {
	peer := req.Peer()
	log.Println(peer.Addr, req.Peer().Query.Get("key"), req.HTTPMethod())
	go func() {
		log.Println(req.Spec().Procedure)
	}()
	return connect.NewResponse(&pingv1.FailResponse{}), nil
}

func call(ctx context.Context, client pingv1connect.PingServiceClient) error {
	req := connect.NewRequest(&pingv1.PingRequest{})
	if _, err := client.Ping(ctx, req); err != nil {
		return err
	}
	log.Println(req.Peer().Addr, req.HTTPMethod())
	stream := client.CumSum(ctx)
	log.Println(stream.Spec().Procedure, stream.Peer().Protocol)
	return stream.CloseRequest()
}
