# Comments between client constructor arguments stay with their arguments.
stubs v2
exec migrate
cmp stdout out.txt
exec migrate -w
exec go build ./...
exec migrate
! stdout 'Proposed rewrites'
-- client.go --
package app

import (
	"net/http"

	"connectrpc.com/connect"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

func newClient(httpClient *http.Client) pingv1connect.PingServiceClient {
	return pingv1connect.NewPingServiceClient(
		// Shared client with retries.
		httpClient,
		"https://example.com/", // webhook endpoint
		// Use gRPC for streaming support.
		connect.WithGRPC(),
		connect.WithSendGzip(), // compress requests
	)
}
-- out.txt --
Proposed rewrites (rerun with -w to apply):
  ./client.go: client_construction=1 import_add_connecthttp=1 import_add_connectv2=1 import_drop_v1=1 option_protocol=1 option_to_connecthttp=1 read_limit_pinned=1
--- ./client.go
+++ ./client.go
@@ -3,18 +3,20 @@
 import (
 	"net/http"
 
-	"connectrpc.com/connect"
+	"connectrpc.com/connect/v2"
+	"connectrpc.com/connect/v2/connecthttp"
 	"example.com/app/gen/connect/ping/v1/pingv1connect"
 )
 
 func newClient(httpClient *http.Client) pingv1connect.PingServiceClient {
-	return pingv1connect.NewPingServiceClient(
+	return pingv1connect.NewPingServiceClient(connect.NewClient(connecthttp.NewTransport(
 		// Shared client with retries.
 		httpClient,
 		"https://example.com/", // webhook endpoint
+		connecthttp.WithReadMaxBytes(0),
 		// Use gRPC for streaming support.
-		connect.WithGRPC(),
-		connect.WithSendGzip(), // compress requests
-	)
+		connecthttp.WithGRPC(),
+		connecthttp.WithSendGzip(), // compress requests
+	)))
 }
 


The following issues require manual code changes:
  ./client.go:11:9: v2 limits reads to 4 MiB per message where v1 allowed any size, so this call is pinned to WithReadMaxBytes(0) to keep v1 behaviour. Drop it to take the v2 default.

Scanned 1 Go file and 0 Buf templates. 1 rewrite(s) ready (rerun with -w to apply).
Full migration guide: https://github.com/connectrpc/connect-go/blob/main/docs/v2-migration.md
