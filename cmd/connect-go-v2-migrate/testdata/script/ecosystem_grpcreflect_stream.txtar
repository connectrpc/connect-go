# grpcreflect ClientStream.Close returns only an error in v2, so a blank header
# result is dropped. A kept header, Spec, Peer, ResponseHeader, and
# WithRequestHeaders are warned.
exec migrate
cmp stdout out.txt
stdout 'grpcreflect_stream_close=1'
stdout 'ClientStream.Close returns only an error'
stdout 'ClientStream.ResponseHeader is removed'
stdout 'grpcreflect.WithRequestHeaders is removed'
-- ecosystem_grpcreflect_stream.go --
package example

import (
	"context"
	"net/http"

	"connectrpc.com/grpcreflect"
)

func listServices(ctx context.Context, client *grpcreflect.Client) error {
	stream := client.NewStream(ctx, grpcreflect.WithRequestHeaders(http.Header{"X-Test": {"1"}}))
	if _, err := stream.ListServices(); err != nil {
		return err
	}
	_ = stream.ResponseHeader()
	_, err := stream.Close()
	return err
}

func closeWithHeader(ctx context.Context, client *grpcreflect.Client) (http.Header, error) {
	stream := client.NewStream(ctx)
	header, err := stream.Close()
	return header, err
}
-- out.txt --
