# The client context seed wraps the context the call sends, not the function's
# ctx parameter.
stubs v2
exec migrate
cmp stdout out.txt
exec migrate -w
exec go build ./...
exec migrate
! stdout 'Proposed rewrites'
-- client.go --
package app

import (
	"context"
	"time"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

func sign(ctx context.Context, client pingv1connect.PingServiceClient, sig string) error {
	req := connect.NewRequest(&pingv1.PingRequest{})
	callCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
	defer cancel()
	if sig != "" {
		req.Header().Set("X-Signature", sig)
	}
	_, err := client.Ping(callCtx, req)
	return err
}

func deliver(ctx context.Context, client pingv1connect.PingServiceClient) (string, error) {
	callCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
	defer cancel()
	res, err := client.Ping(callCtx, connect.NewRequest(&pingv1.PingRequest{}))
	if err != nil {
		return "", err
	}
	return res.GetText() + res.Header().Get("X-Delivery"), nil
}
