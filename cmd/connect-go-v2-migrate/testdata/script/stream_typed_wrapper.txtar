# A v1 stream held in a type of the user's own, by embedding or behind an
# interface, is warned about and its calls are left unchanged.
stubs v2
exec migrate
cmp stdout out.txt
-- service.go --
package app

import (
	"context"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

type loggedStream struct {
	*connect.BidiStreamForClient[pingv1.CumSumRequest, pingv1.CumSumResponse]
}

type logger struct{}

func (logger) wrap(stream *connect.BidiStreamForClient[pingv1.CumSumRequest, pingv1.CumSumResponse]) *loggedStream {
	return &loggedStream{stream}
}

type sender interface {
	Send(*pingv1.CumSumRequest) error
}

func runWrapped(ctx context.Context, client pingv1connect.PingServiceClient, log logger) error {
	stream := log.wrap(client.CumSum(ctx))
	if err := stream.Send(&pingv1.CumSumRequest{Number: 1}); err != nil {
		return err
	}
	return stream.CloseRequest()
}

func runHolder(ctx context.Context, client pingv1connect.PingServiceClient) error {
	var stream sender = client.CumSum(ctx)
	return stream.Send(&pingv1.CumSumRequest{Number: 1})
}
