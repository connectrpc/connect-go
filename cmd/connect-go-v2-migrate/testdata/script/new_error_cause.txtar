# A variable or field error argument becomes the cause; a call gets no cause.
stubs v2
exec migrate
cmp stdout out.txt
exec migrate -w
exec go build ./...
exec migrate
! stdout 'Proposed rewrites'
-- service.go --
package app

import (
	"context"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

type pingServer struct {
	pingv1connect.UnimplementedPingServiceHandler

	state struct{ err error }
}

func (s *pingServer) Fail(ctx context.Context, req *connect.Request[pingv1.FailRequest]) (*connect.Response[pingv1.FailResponse], error) {
	if s.state.err != nil {
		return nil, connect.NewError(connect.CodeUnavailable, s.state.err)
	}
	return nil, connect.NewError(connect.CodeInternal, context.Cause(ctx))
}
-- out.txt --
Proposed rewrites (rerun with -w to apply):
  ./service.go: convert_code_const=2 convert_new_error=2 flip_residual_connect=2 import_add_connectv2=1 import_drop_v1=1 param_unwrap_request=1 result_unwrap_response=1
--- ./service.go
+++ ./service.go
@@ -3,7 +3,7 @@
