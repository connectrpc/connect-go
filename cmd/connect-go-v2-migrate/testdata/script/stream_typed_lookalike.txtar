# A type of the user's own with v1 stream method names is left alone, even next
# to a real stream in the same function: the type checker tells them apart.
stubs v2
exec migrate
cmp stdout out.txt
exec migrate -w
exec go build ./...
exec migrate
! stdout 'Proposed rewrites'
-- queue/queue.go --
package queue

// Queue shares the method names of a v1 stream but is not one.
type Queue struct {
	items []int64
	next  int
}

type Opener struct{}

func (Opener) Open() *Queue { return &Queue{} }

func (q *Queue) Send(n int64) error {
	q.items = append(q.items, n)
	return nil
}

func (q *Queue) CloseRequest() error { return nil }

func (q *Queue) Receive() bool {
	if q.next == len(q.items) {
		return false
	}
	q.next++
	return true
}

func (q *Queue) Msg() int64 { return q.items[q.next-1] }

func (q *Queue) Err() error { return nil }
-- service.go --
package app

import (
	"context"
	"fmt"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"

	"example.com/app/queue"
)

func runCumSum(ctx context.Context, client pingv1connect.PingServiceClient, opener queue.Opener) error {
	if _, err := client.Ping(ctx, connect.NewRequest(&pingv1.PingRequest{})); err != nil {
		return err
	}
	local := opener.Open()
	stream := client.CumSum(ctx)
	for i := int64(1); i <= 3; i++ {
		if err := local.Send(i); err != nil {
			return err
		}
		if err := stream.Send(&pingv1.CumSumRequest{Number: i}); err != nil {
			return err
		}
	}
	if err := local.CloseRequest(); err != nil {
		return err
	}
	if err := stream.CloseRequest(); err != nil {
		return err
	}
	for local.Receive() {
		fmt.Println(local.Msg())
	}
	if err := local.Err(); err != nil {
		return err
	}
	return stream.CloseResponse()
}
