# Bidi consumer created in a closure and used only from nested closures, as in
# an errgroup test. The constructor still becomes (stream, err) and the nested
# CloseRequest/CloseResponse still become CloseSend/Close.
stubs v2
exec migrate
cmp stdout out.txt
exec migrate -w
exec go build ./...
grep 'stream, err := client.CumSum\(ctx\)' service.go
grep 'stream.CloseSend\(\)' service.go
grep 'stream.Close\(\)' service.go
! grep 'CloseRequest|CloseResponse' service.go
-- service.go --
package app

import (
	"context"
	"errors"
	"io"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

type pingServer struct {
	pingv1connect.UnimplementedPingServiceHandler
}

func (s *pingServer) CumSum(ctx context.Context, stream *connect.BidiStream[pingv1.CumSumRequest, pingv1.CumSumResponse]) error {
	return nil
}

func runCumSum(ctx context.Context, clients []pingv1connect.PingServiceClient) error {
	check := func() error {
		for _, client := range clients {
			stream := client.CumSum(ctx)
			errs := make(chan error, 2)
			go func() {
				for i := int64(1); i <= 3; i++ {
					if err := stream.Send(&pingv1.CumSumRequest{Number: i}); err != nil {
						errs <- err
						return
					}
				}
				errs <- stream.CloseRequest()
			}()
			go func() {
				for {
					if _, err := stream.Receive(); err != nil {
						if errors.Is(err, io.EOF) {
							break
						}
						errs <- err
						return
					}
				}
				errs <- stream.CloseResponse()
			}()
			for range 2 {
				if err := <-errs; err != nil {
					return err
				}
			}
		}
		return nil
	}
	return check()
}
