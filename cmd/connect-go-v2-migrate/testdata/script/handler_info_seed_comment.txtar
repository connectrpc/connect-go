# The seeded CallInfo goes above a comment on the handler's first statement,
# leaving the comment with its statement.
stubs v2
exec migrate
cmp stdout out.txt
exec migrate -w
exec go build ./...
exec migrate
! stdout 'Proposed rewrites'
-- service.go --
package app

import (
	"context"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

type pingServer struct {
	pingv1connect.UnimplementedPingServiceHandler
}

func (s *pingServer) Ping(ctx context.Context, req *connect.Request[pingv1.PingRequest]) (*connect.Response[pingv1.PingResponse], error) {
	// Read the caller's token.
	token := req.Header().Get("Authorization")
	return connect.NewResponse(&pingv1.PingResponse{Text: token}), nil
}

func (s *pingServer) Sum(ctx context.Context, req *connect.Request[pingv1.SumRequest]) (*connect.Response[pingv1.SumResponse], error) {
	// Validate first.
	if req.Msg.GetNumber() < 0 {
		return nil, connect.NewError(connect.CodeInvalidArgument, nil)
	}
	// Then read metadata.
	return connect.NewResponse(&pingv1.SumResponse{Sum: int64(len(req.Header().Get("X-Trace")))}), nil
}
