 	if err := ctx.Err(); err != nil {
-		return nil, connect.NewError(connect.CodeInternal, fmt.Errorf("wrap: %w", context.Cause(ctx)))
+		return nil, connect.NewError(connect.CodeInternal, fmt.Errorf("wrap: %w", context.Cause(ctx)).Error())
 	}
