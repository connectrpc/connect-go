# Services in different packages share an RPC name and message base names,
# including a deprecated copy with the same Go package name. The stream param
# resolves by the message's package, not just its name.
exec migrate
cmp stdout out.txt
exec migrate -w
exec go build ./...
-- admin.go --
package app

import (
	"context"

	"connectrpc.com/connect"
	adminv1 "example.com/app/gen/admin/v1"
)

type adminServer struct{}

func (s *adminServer) CleanIntake(ctx context.Context, req *connect.Request[adminv1.CleanIntakeRequest], stream *connect.ServerStream[adminv1.CleanIntakeResponse]) error {
	return stream.Send(&adminv1.CleanIntakeResponse{})
}
-- deprecated.go --
package app

import (
	"context"

	"connectrpc.com/connect"
	adminv1 "example.com/app/gen/deprecated/admin/v1"
)

type legacyServer struct{}

func (s *legacyServer) ShelveTopart(ctx context.Context, stream *connect.ClientStream[adminv1.ShelveTopartRequest]) (*connect.Response[adminv1.ShelveTopartResponse], error) {
	for stream.Receive() {
		_ = stream.Msg()
	}
	return connect.NewResponse(&adminv1.ShelveTopartResponse{}), stream.Err()
}
