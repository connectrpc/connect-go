# A stream with no stream method called on it is still found by its type, so
# its constructor gets the v2 error result. A v1 client stream that no v2 stub
# produced, like a helper parameter or a struct field, is warned about and left
# unchanged.
stubs v2
exec migrate
cmp stdout out.txt
-- service.go --
package app

import (
	"context"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

func runCumSum(ctx context.Context, client pingv1connect.PingServiceClient) error {
	stream := client.CumSum(ctx)
	return pump(stream)
}

func pump(stream *connect.BidiStreamForClient[pingv1.CumSumRequest, pingv1.CumSumResponse]) error {
	if err := stream.Send(&pingv1.CumSumRequest{Number: 1}); err != nil {
		return err
	}
	return stream.CloseRequest()
}

type cumSumStream = *connect.BidiStreamForClient[pingv1.CumSumRequest, pingv1.CumSumResponse]

func aliasPump(stream cumSumStream) error {
	return stream.CloseRequest()
}

type holder struct {
	stream *connect.BidiStreamForClient[pingv1.CumSumRequest, pingv1.CumSumResponse]
}

func (h holder) drain() error {
	stream := h.stream
	for stream.Receive() {
		_ = stream.Msg()
	}
	return stream.CloseResponse()
}
