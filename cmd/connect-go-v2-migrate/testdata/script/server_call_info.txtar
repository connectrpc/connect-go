# Handler request and stream Spec() and Peer().Addr/Protocol move to the
# server CallInfo fields, sharing one seeded info with the header rewrites.
stubs v2
exec migrate
cmp stdout out.txt
exec migrate -w
exec go build ./...
exec migrate
! stdout 'Proposed rewrites'
-- service.go --
package app

import (
	"context"
	"errors"
	"io"
	"log"

	"connectrpc.com/connect"
	pingv1 "example.com/app/gen/connect/ping/v1"
	"example.com/app/gen/connect/ping/v1/pingv1connect"
)

type pingServer struct {
	pingv1connect.UnimplementedPingServiceHandler
}

func (s *pingServer) Ping(ctx context.Context, req *connect.Request[pingv1.PingRequest]) (*connect.Response[pingv1.PingResponse], error) {
	log.Printf("%s from %s over %s", req.Spec().Procedure, req.Peer().Addr, req.Peer().Protocol)
	token := req.Header().Get("Authorization")
	return connect.NewResponse(&pingv1.PingResponse{Text: token}), nil
}

func (s *pingServer) Sum(ctx context.Context, stream *connect.ClientStream[pingv1.SumRequest]) (*connect.Response[pingv1.SumResponse], error) {
	spec := stream.Spec()
	log.Println(spec.Procedure, stream.Peer().Addr)
	return connect.NewResponse(&pingv1.SumResponse{}), nil
}

func (s *pingServer) CountUp(ctx context.Context, req *connect.Request[pingv1.CountUpRequest], stream *connect.ServerStream[pingv1.CountUpResponse]) error {
	if req.Peer().Protocol == connect.ProtocolGRPC {
		log.Println(req.Peer().Addr)
	}
	return stream.Send(&pingv1.CountUpResponse{Number: req.Msg.Number})
}

func (s *pingServer) CumSum(ctx context.Context, stream *connect.BidiStream[pingv1.CumSumRequest, pingv1.CumSumResponse]) error {
	log.Println(stream.Spec().Procedure, stream.Peer().Addr, stream.Peer().Protocol)
	for {
		req, err := stream.Receive()
		if errors.Is(err, io.EOF) {
			return nil
		}
		if err != nil {
			return err
		}
		if err := stream.Send(&pingv1.CumSumResponse{Sum: req.Number}); err != nil {
			return err
		}
	}
}
